rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 &&
             data.price is number && data.price >= 0;
    }

    // Products catalog: publicly readable by all web users
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories: publicly readable by all web users
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Hero slides: publicly readable by all web users
    match /slides/{slideId} {
      allow read: if true;
      allow write: if true;
    }

    // Festival offers: publicly readable by all web users
    match /offers/{offerId} {
      allow read: if true;
      allow write: if true;
    }

    // Store settings and logo: publicly readable by all web users
    match /store_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
